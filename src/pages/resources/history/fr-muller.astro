              </h3>

              <p>
                A historical photograph
                documenting Father Müller's
                charitable work in Mangalore.
              </p>

              <span class="pending-source">
                Library of the National Institute
                of Homoeopathy, Kolkata
              </span>

            </div>

          </div>

        </section>
      )
