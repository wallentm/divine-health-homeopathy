    </section>


    <!-- =========================================================
         SERIES FOOTER
         ========================================================= -->

    <section class="series-footer">

      <div class="reading-column">

        <p class="series-title">
          History. Health. Hope.
        </p>

        <p>
          Real stories from the past that still inspire us today.
        </p>

