const pageTitle =
  "Homeopathy in History: William James | Divine Health Homeopathy";

const pageDescription =
  "Follow the primary-source record of William James’s decades-long engagement with homeopathy—from his medical training and personal experience to his public defense of medical inquiry and later treatment.";
