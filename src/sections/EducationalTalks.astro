<section class="educational-talks" id="educational-talks">
  <div class="talks-container">

    <!-- SECTION HEADING -->
    <div class="section-heading">
      <p class="eyebrow">Divine Health Homeopathy Presents</p>

      <h2>Educational Talks</h2>

    </div>

    <!-- PAST TALKS -->
    <div class="past-talks">

      <div class="past-heading">
        <span></span>
        <h3>Past Talks</h3>
        <span></span>
      </div>

      <div class="past-talks-grid">

        <!-- AUGUST 2026 TALK -->
        <article class="past-flyer-card">
          <div class="flyer-wrap past-flyer-wrap">
            <img
              src="/images/understanding-homeopathy-2026.png"
              alt="Understanding Homeopathy educational presentation flyer"
              class="talk-flyer past-flyer"
              loading="lazy"
            />

            <div class="past-overlay">
              <span>Past Talk</span>
            </div>
          </div>

          <div class="past-talk-info">
            <h4>Understanding Homeopathy</h4>
            <p>August 19, 2026</p>
          </div>
        </article>

        <!-- NOVEMBER 2026 TALK -->
        <article class="past-flyer-card">
          <div class="flyer-wrap past-flyer-wrap">
            <img
              src="/images/homeopathy-for-colds-2026.jpg"
              alt="Learn How Homeopathy Can Help You This Winter educational presentation flyer"
              class="talk-flyer past-flyer"
              loading="lazy"
            />

            <div class="past-overlay">
              <span>Past Talk</span>
            </div>
          </div>

          <div class="past-talk-info">
            <h4>Homeopathy for Cold Season</h4>
            <p>November 4, 2026</p>
          </div>
        </article>

      </div>
    </div>

    <!-- FUTURE TALKS -->
    <div class="future-talks">

      <h3>More Talks Coming Soon</h3>

      <p>
        Thank you to everyone who has joined me for my educational
        presentations! I look forward to continuing these talks
        and exploring more topics in classical homeopathy
        throughout the year.
      </p>

      <p class="future-highlight">
        Stay tuned for the next announcement!
      </p>

      <p>
        Is there a homeopathy topic you'd like to learn more about?
        I'd love to hear your suggestions.
      </p>

      <a
        href="mailto:Mindy@DivineHealthHomeopathy.com?subject=Homeopathy%20Educational%20Talk%20Suggestion"
        class="email-link"
      >
        Suggest a Topic
      </a>
    </div>

  </div>
</section>

<style>
  .educational-talks {
    background: #fbf7ef;
    padding: 6rem 1.5rem 2.5rem;
  }

  .talks-container {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  /* SECTION HEADING */

  .section-heading {
    max-width: 720px;
    margin: 0 auto 0;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #8b8452;
  }

  .section-heading h2 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 500;
    line-height: 1;
    color: #173a6a;
  }

  /* PAST TALKS */

  .past-heading {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .past-heading span {
    height: 1px;
    background: rgba(184, 147, 59, 0.55);
  }

  .past-heading h3 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 2.2rem;
    font-weight: 500;
    color: #173a6a;
  }

  .past-talks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-items: center;
    align-items: start;
    gap: 3rem;
    max-width: 850px;
    margin: 0 auto;
  }

  .past-flyer-card {
    width: min(360px, 100%);
    text-align: center;
  }

  .flyer-wrap {
    position: relative;
    margin: 0 auto;
  }

  .past-flyer-wrap {
    width: 100%;
  }

  .talk-flyer {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
  }

  .past-flyer {
    opacity: 0.85;
    filter: saturate(0.9);
    transition:
      opacity 0.25s ease,
      filter 0.25s ease;
  }

  .past-flyer-wrap:hover .past-flyer {
    opacity: 1;
    filter: saturate(1);
  }

  .past-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .past-overlay span {
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    background: rgba(23, 58, 106, 0.92);
    border: 1px solid #b8933b;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
  }

  .past-talk-info {
    margin-top: 1.4rem;
  }

  .past-talk-info h4 {
    margin: 0 0 0.35rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.7rem;
    font-weight: 600;
    color: #173a6a;
  }

  .past-talk-info p {
    margin: 0;
    font-size: 0.95rem;
    color: #718b62;
  }

  /* FUTURE TALKS */

  .future-talks {
    max-width: 1000px;
    margin: 2.5rem auto 0;
    padding: 3rem 2.5rem;
    text-align: center;
    background: #fffdf8;
    border: 1px solid rgba(184, 147, 59, 0.45);
    border-radius: 20px;
    box-shadow: 0 12px 35px rgba(23, 58, 106, 0.04);
  }

  .future-talks h3 {
    margin: 0 0 1.4rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2rem, 4vw, 2.9rem);
    font-weight: 500;
    line-height: 1.15;
    color: #173a6a;
  }

  .future-talks > p:not(.eyebrow) {
    max-width: 850px;
    margin: 0 auto 1.1rem;
    font-size: 1rem;
    line-height: 1.65;
    color: #383838;
  }

  .future-talks .future-highlight {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.55rem !important;
    font-style: italic;
    font-weight: 600;
    color: #718b62 !important;
  }

  .email-link {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.9rem 1.8rem;
    border-radius: 999px;
    background: #173a6a;
    border: 1px solid #173a6a;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .email-link:hover {
    background: transparent;
    color: #173a6a;
    transform: translateY(-2px);
  }

  .email-link:focus-visible {
    outline: 3px solid #b8933b;
    outline-offset: 4px;
  }

  /* TABLET */

  @media (max-width: 860px) {
    .educational-talks {
      padding: 4.5rem 1.15rem;
    }

    .past-talks-grid {
      gap: 2rem;
    }
  }

  /* MOBILE */

  @media (max-width: 600px) {
    .educational-talks {
      padding: 3.75rem 1rem;
    }

    .section-heading {
      margin-bottom: 3rem;
    }

    .past-heading {
      gap: 0.9rem;
    }

    .past-heading h3 {
      font-size: 1.7rem;
      white-space: nowrap;
    }

    .past-talks-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .past-flyer-card {
      max-width: 340px;
    }

    .future-talks {
      margin-top: 4rem;
      padding: 2.5rem 1.35rem;
    }


/* =========================================
   COMPACT EDUCATIONAL TALKS LAYOUT
   ========================================= */

.educational-talks {
  padding-top: 3.5rem;
  padding-bottom: 3.5rem;
}

.section-heading {
  margin-bottom: 2.5rem;
}

.section-intro {
  margin-top: 0.8rem;
  line-height: 1.6;
}

.past-heading {
  margin-bottom: 1.5rem;
}

.past-talks-grid {
  gap: 2rem;
}

.past-talk-info {
  margin-top: 0.85rem;
}

.past-talk-info h4 {
  margin-bottom: 0.15rem;
  line-height: 1.1;
}

.future-talks {
  margin-top: 2.75rem;
  padding: 2rem 2.5rem;
}

.future-talks h3 {
  margin-bottom: 0.85rem;
  font-size: clamp(1.9rem, 3vw, 2.5rem);
}

.future-talks > p:not(.eyebrow) {
  margin-bottom: 0.85rem;
  line-height: 1.6;
}

.email-link {
  margin-top: 0.25rem;
}

/* MOBILE */

@media (max-width: 600px) {
  .educational-talks {
    padding-top: 2.75rem;
    padding-bottom: 2.75rem;
  }

  .section-heading {
    margin-bottom: 2rem;
  }

  .past-talks-grid {
    gap: 2rem;
  }

  .future-talks {
    margin-top: 2.5rem;
    padding: 1.75rem 1.25rem;
  }
}


  }
</style>
