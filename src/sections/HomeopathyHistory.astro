---
const story = {
  title: "Mother Teresa",
  description:
    "Historical records document connections between Mother Teresa’s charitable work in India and homeopathy, including a homeopathic dispensary in Kidderpore and support for a homeopathic hospital in Kolkata.",
  image: "/images/history/mother-teresa-header.jpg",
  imageAlt:
  "Mother Teresa Homeopathy in History header featuring her portrait and the title An Unexpected Connection to Homeopathy",
  href: "/resources/history/mother-teresa",
};
---

<section class="history-section" id="homeopathy-in-history">
  <div class="history-container">

    <header class="history-heading">
      <p class="eyebrow">Explore the Past</p>

      <h2>Homeopathy in History</h2>

      <p class="history-intro">
        Discover the people, places, and events woven throughout more than
        two centuries of homeopathic history.
      </p>
    </header>

    <article class="featured-story">

      <a
        href={story.href}
        class="featured-image-link"
        aria-label={`Read ${story.title}`}
      >
        <div class="featured-image-wrap">
          <img
            src={story.image}
            alt={story.imageAlt}
            class="featured-image"
            loading="lazy"
          />
        </div>
      </a>

      <div class="featured-content">

        <p class="series-label">Homeopathy in History</p>

        <h3>
          <a href={story.href}>
            {story.title}
          </a>
        </h3>

        <p class="history-description">
          {story.description}
        </p>

        <a href={story.href} class="story-link">
          Explore the Story
          <span aria-hidden="true">→</span>
        </a>

      </div>

    </article>

  </div>
</section>

<style>
  .history-section {
    padding: 5.5rem 1.5rem;
    background: #fbf7ef;
  }

  .history-container {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .history-heading {
    max-width: 720px;
    margin: 0 auto 3.25rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #8b8452;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .history-heading h2 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 500;
    line-height: 1;
    color: #173a6a;
  }

  .history-intro {
    max-width: 650px;
    margin: 1.15rem auto 0;
    font-size: 1.05rem;
    line-height: 1.75;
    color: #383838;
  }

  .featured-story {
  display: block;

  width: min(520px, 100%);
  margin: 0 auto;

  overflow: hidden;

  border: 1px solid rgba(184, 147, 59, 0.5);
  border-radius: 16px;

  background: #fffdf8;

  box-shadow:
    0 12px 32px rgba(23, 58, 106, 0.08);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.featured-story:hover {
  transform: translateY(-4px);

  box-shadow:
    0 18px 38px rgba(23, 58, 106, 0.11);
}

  .featured-image-link {
  display: block;
  width: 100%;
  padding: 0;
  text-decoration: none;
}

.featured-image-wrap {
  width: 100%;
  overflow: hidden;
  background: #fbf7ef;
}

.featured-image {
  display: block;

  width: 100%;
  height: auto;

  transition: transform 0.3s ease;
}

.featured-story:hover .featured-image {
  transform: scale(1.01);
}

  .featured-content {
  display: flex;
  flex-direction: column;
  align-items: center;

  padding: 1.65rem 2rem 2rem;

  text-align: center;
}

  .series-label {
    margin: 0 0 0.8rem;

    color: #8b8452;

    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.17em;
  }

  .featured-content h3 {
  margin: 0;

  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 2.35rem;
  font-weight: 500;
  line-height: 1.05;

  color: #173a6a;
}

  .featured-content h3 a {
    color: inherit;
    text-decoration: none;
  }

  .featured-content h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .history-subtitle {
  margin: 0.4rem 0 0;

  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 1.15rem;
  font-style: italic;
  line-height: 1.3;

  color: #718b62;
}

  .history-description {
  max-width: 420px;
  margin: 0.9rem auto 0;

  font-size: 0.9rem;
  line-height: 1.6;

  color: #383838;
}

  .story-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;

  width: fit-content;

  margin-top: 1.25rem;
  padding: 0.7rem 1.2rem;

  border: 1px solid #173a6a;
  border-radius: 999px;

  background: #173a6a;
  color: #fff;

  font-size: 0.84rem;
  font-weight: 600;
  text-decoration: none;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

  .story-link:hover {
    background: transparent;
    color: #173a6a;
    transform: translateY(-2px);
  }

  .story-link span {
    transition: transform 0.2s ease;
  }

  .story-link:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
  .featured-story {
    width: min(520px, 100%);
  }

  .featured-content {
    padding: 1.6rem 1.75rem 1.9rem;
  }
}

@media (max-width: 640px) {
  .history-section {
    padding: 4.5rem 1rem;
  }

  .history-heading {
    margin-bottom: 2.5rem;
  }

  .featured-story {
    width: 100%;
    border-radius: 15px;
  }

  .featured-content {
    padding: 1.5rem 1.25rem 1.75rem;
  }

  .featured-content h3 {
    font-size: 2.1rem;
  }

  .history-subtitle {
    font-size: 1.08rem;
  }

  .history-description {
    font-size: 0.9rem;
    line-height: 1.6;
  }
}
</style>